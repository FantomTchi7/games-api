{
    "openapi": "3.0.2",
    "info": {
        "title": "games-api",
        "version": "1.0.0",
        "description": "A brand new API with no content.  Go nuts!"
    },
    "paths": {
        "/games": {
            "get": {
                "tags": [
                    "games"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "examples": {
                                    "List of games": {
                                        "value": "[\n    'Witcher 3',\n    'Cyberpunk 2077'\n]"
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "Gets a list of games",
                "description": "Returns a list of games"
            }
        }
    }
}